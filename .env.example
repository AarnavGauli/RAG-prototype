# Copy to backend/.env (local development) or to ./.env (docker compose). Placeholders only - never commit real keys.

# ---- LLM provider (needed to ANSWER questions; uploading/indexing works without it) -----------------
PDFI_LLM_PROVIDER=anthropic              # anthropic | gemini | openai (any OpenAI-compatible server, incl. Ollama)
ANTHROPIC_API_KEY=                       # your Anthropic key (provider=anthropic)
# PDFI_LLM_MODEL=claude-sonnet-5-5       # optional override

# Google Gemini alternative:
# PDFI_LLM_PROVIDER=gemini
# GEMINI_API_KEY=                        # key from aistudio.google.com
# PDFI_LLM_MODEL=gemini-2.5-flash        # optional override

# OpenAI-compatible alternative (OpenAI, Ollama, vLLM, LM Studio ...):
# PDFI_LLM_PROVIDER=openai
# PDFI_LLM_BASE_URL=http://localhost:11434/v1   # Ollama; or https://api.openai.com/v1
# PDFI_LLM_API_KEY=                              # not needed for localhost servers
# PDFI_LLM_MODEL=llama3.1

# ---- Embeddings (local by default; the model is downloaded once on first use, ~70 MB) --------------
PDFI_EMBEDDING_PROVIDER=fastembed        # fastembed | hash (offline, lower quality) | openai
PDFI_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# PDFI_EMBEDDING_API_KEY=                # only for provider=openai
# PDFI_EMBEDDING_BASE_URL=https://api.openai.com/v1

# ---- Storage ----------------------------------------------------------------------------------------
PDFI_DATA_DIR=./data                     # SQLite DB, uploads, FAISS index, model cache (must be persistent)

# ---- Limits -----------------------------------------------------------------------------------------
PDFI_MAX_UPLOAD_MB=20
PDFI_MAX_DOCUMENTS=25
PDFI_MAX_PAGES=500
PDFI_MAX_QUESTION_CHARS=2000
PDFI_RATE_LIMIT_PER_MINUTE=60            # per browser session on expensive endpoints; 0 disables

# ---- RAG tuning (see README "Tuning") ----------------------------------------------------------------
PDFI_CHUNK_SIZE_TOKENS=350
PDFI_CHUNK_OVERLAP_TOKENS=60
PDFI_RETRIEVAL_TOP_K=6
# PDFI_RETRIEVAL_MIN_SCORE=0.5           # cosine floor; default depends on the embedding provider
PDFI_CONTEXT_MAX_TOKENS=3500

# ---- Web ---------------------------------------------------------------------------------------------
PDFI_CORS_ORIGINS=["http://localhost:3000"]   # JSON list; only needed if the browser calls the API directly
PDFI_COOKIE_SECURE=false                      # set true when served over HTTPS
PDFI_ENVIRONMENT=development
PDFI_LOG_LEVEL=INFO

# ---- Frontend (build time) ----------------------------------------------------------------------------
# BACKEND_URL=http://127.0.0.1:8000      # where Next.js proxies /api/*; baked in at `next build`
